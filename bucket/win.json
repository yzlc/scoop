{
    "version": "2026.07.06.1",
    "description": "Windows command tools and setup scripts",
    "homepage": "https://github.com/yzlc/win",
    "url": "https://github.com/yzlc/win/archive/refs/heads/main.zip",
    "bin": [
        [
            "win-main\\config\\tools\\commands\\v2rayn-update.bat",
            "v2rayn-update"
        ],
        [
            "win-main\\config\\tools\\commands\\shutdown23.bat",
            "shutdown23"
        ]
    ],
    "post_install": [
        "cd $dir/win-main",
        ". ./config/config.bat"
    ],
    "pre_uninstall": [
        "Set-Location $env:USERPROFILE",
        ". \"$dir\\win-main\\config\\tools\\uninstall.ps1\""
    ]
}
